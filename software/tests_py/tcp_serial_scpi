import pytest

from labgrid.driver import SerialDriver

from lab_components import multimeter_pymeasure, pdu_multimeter

@pytest.fixture(scope="session")
def esp32(target):
    return target.get_driver(SerialDriver, name="driver_esp32")

def test_idn(esp32):
    esp32.sendline("*IDN?")
    index, before, match, after = esp32.expect("Test, 123456, Firmware 0.0.1")
    print(index, before, match, after)
    if index == 0:
        esp32.sendline("hello friend")
    else:
        esp32.sendline("bye")

